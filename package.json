{
  "name": "stilkompass",
  "version": "1.0.0",
  "description": "Pers\u00f6nlicher AI Fashion Finder f\u00fcr die Schweiz \u2013 kostenlos, Open Source.",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "update": "tsx engine/run.ts",
    "update:embed": "tsx engine/run.ts --embed=3000",
    "dev": "vite",
    "build": "node scripts/copy-ort.mjs && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "node scripts/copy-ort.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@huggingface/transformers": "4.3.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "undici": "7.30.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}